<header class="z-10 py-4 bg-white shadow-md dark:bg-gray-800">
    <div  class="container flex items-center justify-between h-full px-6 mx-auto text-purple-600 dark:text-purple-300" >

        <!-- Menü Linkleri -->
        <div class="flex justify-center flex-1 lg:mr-32">
            <ul class="flex space-x-6 text-sm font-medium text-gray-700 dark:text-gray-300">
                <li>
                    <a href="/dashboard" class="hover:text-purple-600 transition-colors">Dashboard</a>
                </li>
                <li>
                    <a href="/services" class="hover:text-purple-600 transition-colors">Services</a>
                </li>
                <li>
                    <a href="/profile" class="hover:text-purple-600 transition-colors">Profile</a>
                </li>
                <li>
                    <a href="/settings" class="hover:text-purple-600 transition-colors">Settings</a>
                </li>
            </ul>
        </div>

        <ul class="flex items-center flex-shrink-0 space-x-6">
            <!-- Profile menu -->
            <li class="relative">
                <button
                        class="align-middle rounded-full focus:shadow-outline-purple focus:outline-none"
                        @click="toggleProfileMenu"
                        @keydown.escape="closeProfileMenu"
                        aria-label="Account"
                        aria-haspopup="true"
                >
                    <img
                            class="object-cover w-8 h-8 rounded-full"
                            src="https://images.unsplash.com/photo-1502378735452-bc7d86632805?ixlib=rb-0.3.5&q=80&fm=jpg&crop=entropy&cs=tinysrgb&w=200&fit=max&s=aa3a807e1bbdfd4364d1f449eaa96d82"
                            alt=""
                            aria-hidden="true"
                    />
                </button>
            </li>
        </ul>
    </div>
</header>