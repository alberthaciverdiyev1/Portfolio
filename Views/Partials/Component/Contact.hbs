<section>
    <div class="contact" id="contactus">
        <div>
            <h2>İdeyanız var?</h2>
            <p>Biz onu gerçəkləşdirməyə hazırıq.</p>
        </div>
        <div>
            <form action="/contact" method="POST">
                <div class="form-1">
                    <div>
                        <label for="username">Ad, Soyad <span>*</span> </label>
                        <input
                                type="text"
                                id="username"
                                name="username"
                                placeholder="Sizin adınız və soyadınız"
                                class="important"
                        />
                    </div>
                    <div>
                        <label for="email">Email<span>*</span> </label>
                        <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="Email Adresiniz"
                                class="important"
                        />
                    </div>
                </div>
                <div class="form-2">
                    <div>
                        <label for="title">Başlıq <span>*</span> </label>
                        <input
                                type="text"
                                id="title"
                                name="title"
                                placeholder="Başlıq"
                                class="important"
                        />
                    </div>
                    <div>
                        <label for="budget">Büdcəniz</label>
                        <input
                                type="number"
                                id="budget"
                                name="budget"
                                placeholder="Sizə uyğun olan büdcənizi daxil edin"
                        />
                    </div>
                </div>
                <div class="form-3">
                    <label for="message">Mesaj</label>
                    <textarea
                            name="message"
                            id="message"
                            placeholder="Mesajınızı yazın..."
                    ></textarea>
                </div>
<!--                <div class="form-4 d-none">Müraciətiniz uğurla göndərildi</div>-->
                <div class="button">
                    <button type="submit" class="submit-button">Göndər</button>
                </div>
            </form>
        </div>
    </div>
</section>