<div class="container">

    <section>
        <div class="contact-form">
            <h1>İlk addımı sən at qalanı <span>BİZLİKDİR!</span></h1>
            <form action="submit" method="post">
                <div class="form-1">
                    <div>
                        <label for="username">Ad, Soyad <span>*</span> </label>
                        <input
                                type="text"
                                id="username"
                                name="username"
                                placeholder="Sizin adınız və soyadınız"
                                class="important"
                        />
                    </div>
                    <div>
                        <label for="email">Email<span>*</span> </label>
                        <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="Email Adresiniz"
                                class="important"
                        />
                    </div>
                </div>
                <div class="form-2">
                    <div>
                        <label for="title">Başlıq <span>*</span> </label>
                        <input
                                type="text"
                                id="title"
                                name="title"
                                placeholder="Başlıq"
                                class="important"
                        />
                    </div>
                    <div>
                        <label for="budget">Büdcəniz</label>
                        <input
                                type="number"
                                id="budget"
                                name="budget"
                                placeholder="Sizə uyğun olan büdcənizi daxil edin"
                        />
                    </div>
                </div>
                <div class="form-3">
                    <label for="message">{{t "Mesaj"}}</label>
                    <textarea
                            name="message"
                            id="message"
                            placeholder="Mesajınızı yazın..."
                    ></textarea>
                </div>
                <div class="button">
                    <button type="submit" class="submit-button">{{t "Göndər"}}</button>
                </div>
            </form>
        </div>
    </section>

    <section>
        <div class="contacts-info">
            <div class="contact-part">
                <div>
                    <h2>Ünvan</h2>
                    <p>Atatürk prospekti 2a</p>
                </div>
                <div>
                    <h2>Email</h2>
                    <p>contact@jobing.az</p>
                </div>
            </div>
            <div class="contact-part">
                <div>
                    <h2>Əlaqə nömrəsi</h2>
                    <p>+994 (70) 730 72 30</p>
                </div>
                <div>
                    <h2>Sosial şəbəkə</h2>
                    <div class="footer-icons contact-icons">
                        <div>
                            <a href="https://www.instagram.com/" target="_blank">
                                <img src="./img/Vector(1).svg" alt="" class="icon2"
                                /></a>
                        </div>

                        <div>
                            <a href="https://github.com/alberthaciverdiyev1" target="_blank"
                            ><img src="./img/Vector(4).svg" alt="" class="icon5"
                            /></a>
                        </div>
                        <div>
                            <a href="https://www.linkedin.com/company/metraj-az/" target="_blank">
                                <img src="./common/img/linkedin.svg" alt="" style="width: 40px; height: 30px; margin-top: 2px"
                                /></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section>
        <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3038.3173961359194!2d49.84900767473388!3d40.40181895654868!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x40307d5dbd3646f5%3A0x30790f1b36f927d5!2s2a%20Ataturk%20avenue%2C%20Baku!5e0!3m2!1sen!2saz!4v1755703375400!5m2!1sen!2saz"
                style="border: 0"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
    </section>
</div>